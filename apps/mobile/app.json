{
  "expo": {
    "name": "Streakli",
    "slug": "habit-tracker",
    "scheme": "streakli",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0f1e",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#34d399"
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "StreakliToday",
              "label": "Streakli · Today",
              "description": "Today's habits by morning / afternoon / evening — tap to tick off",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/today.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "StreakliProgress",
              "label": "Streakli · Progress",
              "description": "Today's progress ring and best streak",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/progress.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#0a0f1e",
      "resizeMode": "contain",
      "image": "./assets/splash-icon.png",
      "imageWidth": 160
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ruvceski.streakli"
    },
    "android": {
      "package": "com.ruvceski.streakli",
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
